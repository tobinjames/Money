# Optional. Google sign-in reads the web client ID from app/google-services.json.
# Set GOOGLE_WEB_CLIENT_ID only to override it (Firebase console > Authentication >
# Sign-in method > Google > Web SDK configuration). Not a secret; compiled into BuildConfig.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID

# Gemini is called through Firebase AI Logic, so no Gemini API key is needed in the app.
# Do not add GEMINI_API_KEY here; anything in this file can end up in the APK.
