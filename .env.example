# GOOGLE_WEB_CLIENT_ID: OAuth "Web client" ID used for Google sign-in with Firebase Auth.
# Find it in Firebase console > Authentication > Sign-in method > Google > Web SDK configuration.
# This value is not a secret; it is compiled into BuildConfig.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID

# Gemini is called through Firebase AI Logic, so no Gemini API key is needed in the app.
# Do not add GEMINI_API_KEY here; anything in this file can end up in the APK.
