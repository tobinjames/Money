rules_version = '2';

// Security rules for the Family Expense Tracker.
//
// Access model: everything lives under households/{householdId}. A signed-in
// user with a verified email can read and write a household only when their
// uid is in that household's memberUids.
//
//   users/{uid}                 - own profile (which household you belong to)
//   households/{hid}            - name, ownerUid, memberUids, members
//   households/{hid}/{coll}/*   - accounts, transactions, budgets, reminders, reserves,
//                                 smsSenders, merchantRules, privacyKeywords
//   invites/{email}             - lets a member invite a partner by email
//
// Deploy with `firebase deploy --only firestore:rules`, or paste this file
// into Firebase console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid))
        && request.auth.uid in household(hid).memberUids;
    }

    // Only the caller's own entry in the members map may change.
    function onlyOwnMemberEntry() {
      return request.resource.data.members.diff(resource.data.members)
        .affectedKeys().hasOnly([request.auth.uid]);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow read: if isMember(hid);

      // Create a household with only yourself in it.
      allow create: if signedIn()
        && request.resource.data.householdId == hid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);

      // Members may rename the household and update their own member entry.
      allow update: if isMember(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members'])
        && onlyOwnMemberEntry();

      // An invited user may add themselves (and nothing else).
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && get(/databases/$(database)/documents/invites/$(myEmail())).data.householdId == hid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.auth.uid in request.resource.data.memberUids
        && onlyOwnMemberEntry();

      allow delete: if isMember(hid) && resource.data.ownerUid == request.auth.uid;

      match /{coll}/{docId} {
        allow read, write: if isMember(hid)
          && coll in ['accounts', 'transactions', 'budgets', 'reminders', 'reserves',
                      'smsSenders', 'merchantRules', 'privacyKeywords'];
      }
    }

    match /invites/{email} {
      // The invitee can see and decline their invite; members can see and withdraw it.
      allow get: if signedIn() && (email == myEmail() || isMember(resource.data.householdId));
      allow delete: if signedIn() && (email == myEmail() || isMember(resource.data.householdId));

      // A member invites someone into their own household.
      function validInvite() {
        return isMember(request.resource.data.householdId)
          && email == email.lower()
          && request.resource.data.email == email
          && request.resource.data.invitedByUid == request.auth.uid
          && email != myEmail();
      }
      allow create: if validInvite();
      // Re-sending your own household's invite is fine; taking over another household's is not.
      allow update: if validInvite() && isMember(resource.data.householdId);
    }
  }
}
